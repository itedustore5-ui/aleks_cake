# Supabase — OBAVEZNO Session pooler, port 5432 (Direct connection radi samo preko IPv6,
# Render ga ne dohvata). Kopirati iz Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.xxxxx:lozinka@aws-0-region.pooler.supabase.com:5432/postgres

NODE_ENV=development
PORT=5000

# Adresa na kojoj aplikacija zaista radi — koristi je alati/provjeri.mjs kad se doda.
APP_URL=http://localhost:5000

# Push obavještenja na telefon — NIJE potrebno: server pravi ključ sam i čuva ga u bazi klijenta.
# Samo ako se ključ želi zadati ručno (isti ključ = postojeće pretplate i dalje rade):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:adresa@primjer.me

# „Stanje poslovanja“ direktoru mejlom (samo na Renderu, PLAĆENI plan — besplatni blokira SMTP).
# Bez ovoga aplikacija radi, a izvještaj se preuzima i šalje kao prilog.
# Gmail: lozinka za aplikacije (Google nalog → Bezbjednost → potvrda u dva koraka), ne obična lozinka.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_KORISNIK=adresa@gmail.com
# SMTP_LOZINKA=
# SMTP_POSILJALAC=Ime Prezime <adresa@gmail.com>
